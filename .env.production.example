# Hospital Operations Portal production environment template.
# Copy to .env.production on the server and set secrets through protected environment values.

# Public URLs
PUBLIC_APP_URL=https://hop.namuenhospital.go.th
VITE_API_BASE_URL=
HTTP_PORT=80

# PostgreSQL
POSTGRES_DB=hop_db
POSTGRES_USER=hop_app
POSTGRES_PASSWORD=
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
DB_HOST=postgres
DB_PORT=5432
ConnectionStrings__DefaultConnection=Host=localhost;Port=55432;Database=hop_db;Username=hop_user;Password=

# Backend
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
Jwt__Key=
Jwt__Issuer=Hop.Api
Jwt__Audience=Hop.Client
Jwt__AccessTokenMinutes=15
Jwt__ClockSkewMinutes=2
Hospital__Name=โรงพยาบาลนาหมื่น
Hospital__LogoPath=/opt/hop/backend/assets/logo/hospital-logo.png
Branding__LogoPath=/opt/hop/backend/assets/logo/hospital-logo.png
Database__SeedOnStartup=false
Seed__CreateDefaultAdmin=false
Seed__AdminUsername=
Seed__AdminPassword=
Seed__StandardItPassword=
Seed__AdminFullName=
Seed__AdminEmployeeCode=

# Frontend branding
VITE_APP_NAME=Hospital Operations Portal
VITE_HOSPITAL_NAME=โรงพยาบาลนาหมื่น
VITE_APP_VERSION=2.0.0
VITE_LIFF_ID=
VITE_LIFF_BASE_URL=https://miniapp.line.me

# Auth and CSRF
Auth__TokenStorageMode=Cookie
Auth__Cookie__Secure=true
Auth__Cookie__SameSite=Lax
Auth__Cookie__Domain=
Auth__Cookie__RefreshTokenName=hop_refresh_token
Auth__Cookie__CsrfEnabled=true
Auth__Cookie__CsrfTokenName=hop_csrf_token
Auth__Cookie__CsrfHeaderName=X-CSRF-TOKEN
Cors__AllowCredentials=true
Cors__AllowedOrigins__0=https://hop.namuenhospital.go.th
VITE_AUTH_TOKEN_STORAGE_MODE=cookie
VITE_AUTH_CSRF_COOKIE_NAME=hop_csrf_token
VITE_AUTH_CSRF_HEADER_NAME=X-CSRF-TOKEN
ForwardedHeaders__KnownProxies__0=127.0.0.1

# Uploads and malware scanning
Storage__RootPath=/opt/hop/storage
Storage__PublicBaseUrl=https://hop.namuenhospital.go.th/storage
Storage__Announcements__MaxImageSizeBytes=10485760
Storage__Announcements__MaxAttachmentSizeBytes=10485760
Storage__Announcements__AllowedImageExtensions__0=.jpg
Storage__Announcements__AllowedImageExtensions__1=.jpeg
Storage__Announcements__AllowedImageExtensions__2=.png
Storage__Announcements__AllowedImageExtensions__3=.webp
Storage__Announcements__AllowedAttachmentExtensions__0=.pdf
Storage__Announcements__AllowedAttachmentExtensions__1=.doc
Storage__Announcements__AllowedAttachmentExtensions__2=.docx
Storage__Announcements__AllowedAttachmentExtensions__3=.xls
Storage__Announcements__AllowedAttachmentExtensions__4=.xlsx
Storage__Announcements__AllowedAttachmentExtensions__5=.ppt
Storage__Announcements__AllowedAttachmentExtensions__6=.pptx
Storage__Announcements__AllowedAttachmentExtensions__7=.zip
LeaveAttachments__MaxFileSizeMb=5
LeaveAttachments__AllowedExtensions=.pdf,.jpg,.jpeg,.png
FileScan__Enabled=true
FileScan__Provider=ClamAV
FileScan__FailClosed=true
ClamAv__TimeoutMs=5000

# LINE notification configuration
Line__Enabled=true
Line__ChannelId=
Line__AccessToken=
Line__ChannelAccessToken=
Line__ChannelSecret=
Line__WebhookUrl=https://hop.namuenhospital.go.th/api/line/webhook
Line__PublicAppUrl=https://hop.namuenhospital.go.th
Line__PublicFileBaseUrl=https://hop.namuenhospital.go.th
Line__TestUserId=
Line__LiffId=
Line__LiffBaseUrl=https://miniapp.line.me
Line__LoginChannelId=
Line__LoginChannelSecret=
Line__IdTokenVerifyUrl=https://api.line.me/oauth2/v2.1/verify
LineRetry__Enabled=true

# Operations
ApprovalEscalation__Enabled=false
RefreshToken__ReuseDetectionEnabled=true
LoginRateLimit__Enabled=true
AuditLog__RetentionDays=365
